# ============================================================================
# Baby Secret — environment template
# ============================================================================
# Copy to `.env.local` for local development, and add the same keys to
# Vercel → Project Settings → Environment Variables for production.
#
# RULES
#   * Placeholders only in this file. Never commit a real value here.
#   * Anything prefixed NEXT_PUBLIC_ is bundled into the browser. Only public,
#     display-only values may use that prefix — never a password, API key,
#     webhook secret or OAuth secret.
#   * Changing a variable in Vercel requires a REDEPLOY to take effect.
# ============================================================================

# ---------------------------------------------------------------------------
# WooCommerce (server-only)
# ---------------------------------------------------------------------------
# REST API base, e.g. https://app.babysecret.com/wp-json/wc/v3
WOOCOMMERCE_REST_URL=
# Create under WooCommerce → Settings → Advanced → REST API. Server-only:
# this key pair can read and modify live orders.
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=
# Public Store API base used for product browsing (safe to expose).
NEXT_PUBLIC_WOOCOMMERCE_STORE_API_URL=
# WooCommerce admin base URL, used to deep-link admin emails to an order.
WOOCOMMERCE_ADMIN_URL=

# ---------------------------------------------------------------------------
# WooCommerce webhook (server-only)
# ---------------------------------------------------------------------------
# Secret used to sign the `order.updated` webhook. Copy this exact value into
# WooCommerce → Settings → Advanced → Webhooks → Secret. An empty value makes
# the webhook endpoint refuse every request with HTTP 500.
WOOCOMMERCE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Email — Titan SMTP (server-only)
# ---------------------------------------------------------------------------
# Titan SMTP is the transport for custom Next.js application emails. There is no
# Brevo fallback, and Google OAuth credentials must not be used for SMTP.
# WooCommerce's own order emails remain handled by FluentSMTP + Titan in
# WordPress; this transport sends only Next.js application mail such as OTP,
# password-reset, awaiting-payment, and transfer-submitted messages.
EMAIL_HOST=smtp.titan.email
EMAIL_PORT=465
EMAIL_USER=
EMAIL_PASSWORD=
# Display-name form is supported. Quote the value.
EMAIL_FROM="Baby Secret <hello@babysecret.com>"
# Comma-separated inbox(es) for admin notifications. Falls back to the
# EMAIL_FROM address when blank.
EMAIL_ADMIN_TO=
# Optional. Defaults to true for port 465 (implicit TLS), false otherwise.
# EMAIL_SECURE=true
# WooCommerce core has no shipped status; these are slugs added by shipping
# plugins. Unset uses the built-in list.
# EMAIL_SHIPPED_STATUSES=shipped,in-transit,out-for-delivery

# ---------------------------------------------------------------------------
# Bank Transfer (server-only)
# ---------------------------------------------------------------------------
# Receiving account. There are NO hardcoded fallbacks anywhere in the code: if
# these are blank, bank transfer fails closed with an error rather than showing
# a placeholder account number.
MONIEPOINT_BANK_NAME=
MONIEPOINT_ACCOUNT_NAME=
MONIEPOINT_ACCOUNT_NUMBER=
# Client-side display fallback for the same account. A receiving account is
# shown to customers by nature, so these are public — but keep them in sync
# with the MONIEPOINT_* values above.
NEXT_PUBLIC_BANK_NAME=
NEXT_PUBLIC_BANK_ACCOUNT_NAME=
NEXT_PUBLIC_BANK_ACCOUNT_NUMBER=

# ---------------------------------------------------------------------------
# Terminal Africa — delivery (server-only)
# ---------------------------------------------------------------------------
# tship = Terminal Africa (the only customer-facing provider).
# shipbubble is preserved but disabled via ENABLED_SHIPPING_PROVIDERS in
# src/services/shipping/shipping.service.ts; re-add it there to re-enable.
SHIPPING_PROVIDER=tship
TERMINAL_API_KEY=
TERMINAL_API_BASE=https://api.terminal.africa/v1
# Shipbubble (disabled; kept for future use). Do not enable until the account
# is approved for live mode.
# SHIPPUBBLE_API_KEY=
# SHIPPUBBLE_API_BASE=https://api.shipbubble.com/v1
# Quote origin for Terminal Africa (the store's address).
SHIPPING_PICKUP_FIRST_NAME=
SHIPPING_PICKUP_LAST_NAME=
SHIPPING_PICKUP_EMAIL=
SHIPPING_PICKUP_PHONE=
SHIPPING_PICKUP_ADDRESS=
SHIPPING_PICKUP_CITY=
SHIPPING_PICKUP_STATE=
SHIPPING_PICKUP_COUNTRY=NG
SHIPPING_PICKUP_ZIP=

# ---------------------------------------------------------------------------
# Payments — gateway providers (server-only)
# ---------------------------------------------------------------------------
# Bank Transfer is the only method shown to customers. Paystack and
# Flutterwave remain fully implemented but hidden from the UI; their keys are
# only needed if you re-enable them.
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
# Exact value Flutterwave sends back in the `verif-hash` webhook header.
# Set this to the secret hash configured in the Flutterwave dashboard;
# webhooks are compared directly against it (no HMAC involved).
# FLUTTERWAVE_WEBHOOK_SECRET_HASH=

# ---------------------------------------------------------------------------
# Authentication (NextAuth v5 + WooCommerce customers)
# ---------------------------------------------------------------------------
# Used to sign session JWTs. Rotate with care: changing it logs everyone out.
AUTH_SECRET=
# Optional dedicated pepper for OTP HMACs and password-reset token seals.
# Falls back to AUTH_SECRET when unset. Rotate with care: rotation instantly
# invalidates outstanding OTPs and reset links (by design).
# OTP_PEPPER=
# Google OAuth login credentials (https://console.cloud.google.com/apis/credentials).
# These are for LOGIN ONLY and are completely separate from the Titan SMTP
# mailbox credentials above — never reuse one for the other.
# Register the /api/auth/callback/google redirect URI for EVERY environment:
#   http://localhost:3000/api/auth/callback/google        (local dev)
#   https://<vercel-domain>/api/auth/callback/google     (preview deploy)
#   https://babysecret.com/api/auth/callback/google       (production)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Set to "true" to show the "Continue with Google" button.
NEXT_PUBLIC_GOOGLE_LOGIN_ENABLED=false
# Public base URL used in password-reset links.
NEXT_PUBLIC_APP_URL=https://babysecret.com
# Lets NextAuth trust the request host (Vercel sets this automatically; set it
# for a custom domain or a non-Vercel host).
AUTH_TRUST_HOST=true