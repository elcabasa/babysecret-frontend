NEXT_PUBLIC_WOOCOMMERCE_STORE_API_URL=https://babysecret.com/wp-json/wc/store/v1
# Server-only configuration; never expose secrets through NEXT_PUBLIC_* variables.
PAYMENT_PROVIDER=demons
WOOCOMMERCE_REST_URL=https://babysecret.com/wp-json/wc/v3
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=

# Authentication (NextAuth v5 + WooCommerce customers)
# Required for JSON Web Token signing.
AUTH_SECRET=
# Google OAuth app credentials (https://console.cloud.google.com/apis/credentials).
# Register the /api/auth/callback/google redirect URI for EVERY environment:
#   http://localhost:3000/api/auth/callback/google            (local dev)
#   https://<vercel-test-domain>/api/auth/callback/google     (test deploy)
#   https://<your-domain>/api/auth/callback/google            (production)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Set to "true" to show the "Continue with Google" button.
NEXT_PUBLIC_GOOGLE_LOGIN_ENABLED=false
# Public base URL used in emailed password-reset links.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Lets NextAuth trust the request host (Vercel sets this automatically; set it
# for a custom domain or non-Vercel server). Prevents hard-coding any domain.
AUTH_TRUST_HOST=true
# Transactional email via Brevo (courier set up on the WooCommerce site).
# Emails are dispatched from the SMTP_FROM sender the store uses with FluentSMTP.
BREVO_API_KEY=
SMTP_FROM=info@babysecret.com

# Shipping / logistics (Terminal Africa TShip / Shipbubble)
# SHIPPING_PROVIDER=tship enables live delivery rates via Terminal Africa
# SHIPPING_PROVIDER=shipbubble enables live delivery rates via Shipbubble
# SHIPPING_PROVIDER=woocommerce (rates from the store's WooCommerce shipping zones).
# SHIPPING_PROVIDER=mock (fallback demo rates).
SHIPPING_PROVIDER=tship
# On any provider error, optionally fall back to mock demo rates.
# SHIPPING_FALLBACK=mock
TERMINAL_API_KEY=
TERMINAL_API_BASE=https://api.terminal.africa/v1
# Shipbubble API key (sandbox: sb_sandbox_...; production: sb_prod_...).
# Required when SHIPPING_PROVIDER=shipbubble.
# SHIPPUBBLE_API_KEY=
# Shipbubble API base URL (defaults to https://api.shipbubble.com/v1).
# SHIPPUBBLE_API_BASE=https://api.shipbubble.com/v1
# Store pickup location used as the quote origin.
SHIPPING_PICKUP_FIRST_NAME=Baby Secret
SHIPPING_PICKUP_LAST_NAME=Store
SHIPPING_PICKUP_EMAIL=delivery@babysecret.com
SHIPPING_PICKUP_PHONE=+2348012345678
SHIPPING_PICKUP_ADDRESS=12 Admiralty Way, Lekki Phase 1
SHIPPING_PICKUP_CITY=Ikeja
SHIPPING_PICKUP_STATE=Lagos
SHIPPING_PICKUP_COUNTRY=NG
SHIPPING_PICKUP_ZIP=121006
# Default per-unit parcel weight (kg) attributed to each cart item.
SHIPPING_ITEM_WEIGHT_KG=0.4
